generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  WISHLIST
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  GHOSTED
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
}

enum JobType {
  ONSITE
  HYBRID
  REMOTE
}

enum DiscoverySource {
  LINKEDIN
  LINKEDIN_JOBS
  GOOGLE_SEARCH
  INDEED
  ROZEE
  REFERRAL
  CAREER_EMAIL
  JOBLEADS
  TARAKI
  OTHER
}

enum ApplicationChannel {
  COMPANY_WEBSITE
  ATS
  LINKEDIN
  INDEED
  ROZEE
  REFERRAL
  CAREER_EMAIL
  TARAKI
  OTHER
}

enum JobEventType {
  CREATED
  STATUS_CHANGE
  INTERVIEW_ROUND_ADDED
}

enum EnrichmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum InterviewOutcome {
  PENDING
  PASSED
  FAILED
  CANCELLED
}

enum Role {
  USER
  ADMIN
}

enum CompanyCity {
  LAHORE
  ISLAMABAD
  KARACHI
  OTHER
}

enum BusinessMode {
  PRODUCT
  SERVICES
  HYBRID
}

enum DigestFrequency {
  OFF
  DAILY
  WEEKLY
}

model User {
  id                        String          @id @default(cuid())
  email                     String          @unique
  password                  String?
  name                      String
  avatarUrl                 String?
  role                      Role            @default(USER)
  interviewRemindersEnabled Boolean         @default(true)
  digestFrequency           DigestFrequency @default(OFF)
  timezone                  String          @default("UTC")
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  jobs                      Job[]
  companies                 Company[]
  accounts                  Account[]
  refreshTokens             RefreshToken[]
  apiTokens                 ApiToken[]

  @@index([digestFrequency])
}

model RefreshToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// Personal access tokens for non-browser clients (e.g. the browser
// extension) that can't use the httpOnly refresh-token cookie. Exchanged
// server-side for a short-lived access JWT — see AuthService.exchangeApiToken.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  // Set at creation to createdAt + 180 days (see TokensService.create). A
  // permanent bearer credential with no time-based ceiling is a bigger risk
  // than manual revoke alone covers — this bounds exposure if a device is
  // compromised and the user never notices/revokes.
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

model Account {
  id                String @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Job {
  id                          String           @id @default(cuid())
  company                     String
  position                    String
  location                    String?
  url                         String?
  status                      JobStatus        @default(APPLIED)
  priority                    JobPriority      @default(MEDIUM)
  jobType                     JobType          @default(ONSITE)
  discoverySource             DiscoverySource?
  applicationChannel          ApplicationChannel?
  notes                       String?
  appliedAt                   DateTime         @default(now())
  nextInterviewAt             DateTime?
  // Digest dedup for the two "stalled" attention types (STALE_APPLIED,
  // STALE_INTERVIEWING): stamped to the send time once an occurrence has
  // been reported. Compared against the item's `since` in getAttentionItems'
  // callers — since stays fixed while an item remains stale, so
  // digestedAt >= since means "already reported, still the same occurrence."
  // UPCOMING_INTERVIEW isn't tracked here — its 48h window self-resolves
  // in a couple of days and has its own dedicated reminder email already.
  staleAppliedDigestedAt      DateTime?
  staleInterviewingDigestedAt DateTime?
  // LLM-generated one-line plain-English summary of this job's JobEvent
  // timeline, regenerated asynchronously (TimelineSummaryProcessor) whenever
  // a new event is written. null until the first background run completes.
  timelineSummary             String?
  timelineSummaryAt           DateTime?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
  userId                      String
  user                        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events                      JobEvent[]
  resume                      Resume?
  interviewRounds             InterviewRound[]
  contacts                    Contact[]
  companyId                   String?
  companyLink                 Company?         @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([userId, appliedAt])
  @@index([userId, createdAt])
  @@index([userId, nextInterviewAt])
  @@index([companyId])
}

model Company {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  city          CompanyCity
  location      String?
  priority      JobPriority  @default(MEDIUM)
  personalNotes String?
  websiteUrl    String?
  linkedinUrl   String?

  // AI-fillable, user-correctable — see docs/specs/target-companies.md
  // "Company Fields — Scope" and Assumption 9 (refresh always overwrites,
  // no per-field provenance tracking).
  businessMode              BusinessMode?
  productDescription        String?
  // No default (unlike CompanyProfile, this row always exists from creation)
  // — null means "enrichment never triggered", distinct from PENDING/
  // PROCESSING ("currently queued/running"). See the conflict check in
  // CompaniesController.triggerEnrichment.
  status                    EnrichmentStatus?
  industry                  String?
  companySize               String?
  techStack                 String[]
  cultureSummary            String?
  workPolicy                String?
  workLifeBalance           String?
  headquarters              String?
  headquartersLowConfidence Boolean          @default(false)
  address                   String?
  addressLowConfidence      Boolean          @default(false)
  founded                   String?
  errorMessage              String?
  enrichedAt                DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contact[]
  jobs      Job[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, city])
  @@index([userId, priority])
  @@map("companies")
}

model Resume {
  id           String   @id @default(cuid())
  jobId        String   @unique
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  originalName String
  size         Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())
}

model InterviewRound {
  id             String           @id @default(cuid())
  jobId          String
  job            Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage          String
  scheduledAt    DateTime
  outcome        InterviewOutcome @default(PENDING)
  notes          String?
  reminderSentAt DateTime?
  // LLM-generated talking points/questions for THIS round, produced from the
  // debrief notes on the previously-completed round for the same job (see
  // InterviewRoundsService.maybeGenerateNextRoundPrep). null until generated;
  // never regenerated automatically once set.
  prepSuggestions String?
  prepGeneratedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([jobId])
  @@index([outcome, scheduledAt, reminderSentAt])
  @@map("interview_rounds")
}

model Contact {
  id          String   @id @default(cuid())
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  role        String?
  email       String?
  phone       String?
  linkedinUrl String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
  @@index([companyId])
  @@map("contacts")
}

model JobEvent {
  id         String       @id @default(cuid())
  jobId      String
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type       JobEventType
  fromStatus JobStatus?
  toStatus   JobStatus
  note       String?
  createdAt  DateTime     @default(now())

  // Composite, not a bare [jobId]: every read of this table filters by jobId
  // and then orders by createdAt — the paginated timeline (JobsService
  // .getEvents), the summariser's most-recent-50 (TimelineSummaryProcessor),
  // and the funnel's [jobId, createdAt] scan (JobsStatsService.getFunnel).
  // The composite serves that ordering directly instead of making Postgres
  // sort the matched rows. It also covers everything a lone [jobId] index did
  // — leading-column prefix, so plain jobId lookups, the count in getEvents,
  // and the FK cascade delete from Job all still use it — which is why that
  // index is dropped rather than kept alongside.
  @@index([jobId, createdAt])
  @@map("job_events")
}
