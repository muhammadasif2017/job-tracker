generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  WISHLIST
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  GHOSTED
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
}

enum JobType {
  ONSITE
  HYBRID
  REMOTE
}

enum DiscoverySource {
  LINKEDIN
  LINKEDIN_JOBS
  GOOGLE_SEARCH
  INDEED
  ROZEE
  REFERRAL
  CAREER_EMAIL
  OTHER
}

enum ApplicationChannel {
  COMPANY_WEBSITE
  ATS
  LINKEDIN
  INDEED
  ROZEE
  REFERRAL
  CAREER_EMAIL
  OTHER
}

enum JobEventType {
  CREATED
  STATUS_CHANGE
  INTERVIEW_ROUND_ADDED
}

enum EnrichmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum InterviewOutcome {
  PENDING
  PASSED
  FAILED
  CANCELLED
}

enum Role {
  USER
  ADMIN
}

enum DigestFrequency {
  OFF
  DAILY
  WEEKLY
}

model User {
  id                        String          @id @default(cuid())
  email                     String          @unique
  password                  String?
  name                      String
  avatarUrl                 String?
  role                      Role            @default(USER)
  interviewRemindersEnabled Boolean         @default(true)
  digestFrequency           DigestFrequency @default(OFF)
  timezone                  String          @default("UTC")
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  jobs                      Job[]
  accounts                  Account[]
  refreshTokens             RefreshToken[]
  apiTokens                 ApiToken[]

  @@index([digestFrequency])
}

model RefreshToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// Personal access tokens for non-browser clients (e.g. the browser
// extension) that can't use the httpOnly refresh-token cookie. Exchanged
// server-side for a short-lived access JWT — see AuthService.exchangeApiToken.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  // Set at creation to createdAt + 180 days (see TokensService.create). A
  // permanent bearer credential with no time-based ceiling is a bigger risk
  // than manual revoke alone covers — this bounds exposure if a device is
  // compromised and the user never notices/revokes.
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

model Account {
  id                String @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Job {
  id                          String           @id @default(cuid())
  company                     String
  position                    String
  location                    String?
  url                         String?
  status                      JobStatus        @default(APPLIED)
  priority                    JobPriority      @default(MEDIUM)
  jobType                     JobType          @default(ONSITE)
  discoverySource             DiscoverySource?
  applicationChannel          ApplicationChannel?
  notes                       String?
  appliedAt                   DateTime         @default(now())
  nextInterviewAt             DateTime?
  // Digest dedup for the two "stalled" attention types (STALE_APPLIED,
  // STALE_INTERVIEWING): stamped to the send time once an occurrence has
  // been reported. Compared against the item's `since` in getAttentionItems'
  // callers — since stays fixed while an item remains stale, so
  // digestedAt >= since means "already reported, still the same occurrence."
  // UPCOMING_INTERVIEW isn't tracked here — its 48h window self-resolves
  // in a couple of days and has its own dedicated reminder email already.
  staleAppliedDigestedAt      DateTime?
  staleInterviewingDigestedAt DateTime?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
  userId                      String
  user                        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events                      JobEvent[]
  companyProfile              CompanyProfile?
  resume                      Resume?
  interviewRounds             InterviewRound[]
  contacts                    Contact[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, appliedAt])
  @@index([userId, createdAt])
  @@index([userId, nextInterviewAt])
}

model CompanyProfile {
  id              String           @id @default(cuid())
  jobId           String           @unique
  job             Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status          EnrichmentStatus @default(PENDING)
  industry        String?
  companySize     String?
  techStack       String[]
  cultureSummary  String?
  workPolicy      String?
  workLifeBalance String?
  headquarters    String?
  headquartersLowConfidence Boolean @default(false)
  address         String?
  addressLowConfidence     Boolean @default(false)
  founded         String?
  errorMessage    String?
  enrichedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("company_profiles")
}

model Resume {
  id           String   @id @default(cuid())
  jobId        String   @unique
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  originalName String
  size         Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())
}

model InterviewRound {
  id             String           @id @default(cuid())
  jobId          String
  job            Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage          String
  scheduledAt    DateTime
  outcome        InterviewOutcome @default(PENDING)
  notes          String?
  reminderSentAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([jobId])
  @@index([outcome, scheduledAt, reminderSentAt])
  @@map("interview_rounds")
}

model Contact {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  role        String?
  email       String?
  phone       String?
  linkedinUrl String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
  @@map("contacts")
}

model JobEvent {
  id         String       @id @default(cuid())
  jobId      String
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type       JobEventType
  fromStatus JobStatus?
  toStatus   JobStatus
  note       String?
  createdAt  DateTime     @default(now())

  @@index([jobId])
  @@map("job_events")
}
